<Window x:Class="WLMouseTaskbar.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLMouseTaskbarWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        窗口本身铺满整个任务栏，再用 SetWindowRgn 只保留 Pill 那块可见。
        这是 FluentFlyout 的做法：小尺寸的 WS_EX_LAYERED 子窗口，其合成表面
        会被丢弃导致完全不显示；铺满整条任务栏才稳定。

        外观仿 Windows 自带的笔记本电量：没有底板、没有边框，只有一个白色
        电池图形加百分比，和托盘里那几个系统图标是同一视觉层级。
    -->
    <Canvas x:Name="Root" Background="Transparent">

        <Border x:Name="Pill"
                Height="24"
                Background="Transparent"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseRightButtonUp="Pill_MouseRightButtonUp">
            <Border.ContextMenu>
                <ContextMenu x:Name="Menu" Opened="Menu_Opened">
                    <MenuItem x:Name="MenuBattery" Header="电量：—" IsEnabled="False" />
                    <Separator />
                    <MenuItem x:Name="MenuDpi" Header="DPI" />
                    <MenuItem x:Name="MenuPolling" Header="回报率" />
                    <Separator />
                    <MenuItem Header="立即刷新" Click="MenuRefresh_Click" />
                    <MenuItem Header="设置…" Click="MenuSettings_Click" />
                    <MenuItem Header="在通知区显示图标" x:Name="MenuTrayToggle"
                              IsCheckable="True" IsChecked="True" Click="MenuTrayToggle_Click" />
                    <Separator />
                    <MenuItem Header="退出" Click="MenuExit_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <!--
                靠左对齐而不是居中：Pill 的宽度就是内容的宽度，右边沿才等于内容的
                右边沿。居中会在两侧留出对不齐的空白，锚定时算出来的位置看着就
                「没贴住」。
            -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">

                <!-- 电池：外壳 + 按电量填充的液面 + 右侧电极；充电时液面换成闪电 -->
                <Grid Width="21" Height="11" VerticalAlignment="Center">
                    <Border x:Name="Shell" BorderThickness="1.3" CornerRadius="2.6" />
                    <Border x:Name="Fill" CornerRadius="1.2"
                            HorizontalAlignment="Left" Margin="2" Width="0" />
                    <Rectangle x:Name="Tip" Width="1.9" Height="4.2"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,-2.8,0" RadiusX="0.95" RadiusY="0.95" />
                    <Path x:Name="Bolt"
                          Width="6" Height="8.5"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Data="M3,0 L0,6 L2.6,6 L1.4,10 L5.6,3.6 L3,3.6 L4.6,0 Z" />
                </Grid>

                <TextBlock x:Name="PercentText" Text="—"
                           Margin="5,0,0,0"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
