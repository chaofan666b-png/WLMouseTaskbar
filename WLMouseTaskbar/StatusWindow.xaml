<Window x:Class="WLMouseTaskbar.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WL Mouse 电量"
        Width="640" Height="780"
        MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="#FFF7F7F9">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：大号电量 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="BigPercent" Text="—" FontSize="44" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLine" Text="正在读取…" FontSize="14" />
                <TextBlock x:Name="UpdatedLine" Text="—" FontSize="12" Foreground="#FF6B7280" />
            </StackPanel>
        </StackPanel>

        <!-- 中部可滚动内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="设备" Style="{StaticResource SectionHeader}" />
                <Border Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#FFE5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="设备" Foreground="#FF6B7280" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceLine" Text="—" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="鼠标固件" Foreground="#FF6B7280" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MouseFwLine" Text="—" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="接收器固件" Foreground="#FF6B7280" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ReceiverFwLine" Text="—" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="最近回包" Foreground="#FF6B7280" Margin="0,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RawLine" Text="—" Margin="0,3"
                                   FontFamily="Consolas" FontSize="11.5" />
                    </Grid>
                </Border>

                <TextBlock Text="显示" Style="{StaticResource SectionHeader}" />
                <Border Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#FFE5E7EB" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="ShowWidgetCheck" Content="在任务栏显示电量" Checked="OnDisplayChanged" Unchecked="OnDisplayChanged" />
                        <CheckBox x:Name="ShowTrayCheck" Content="在通知区域显示图标" Checked="OnDisplayChanged" Unchecked="OnDisplayChanged" />
                        <CheckBox x:Name="HideDisconnectedCheck" Content="鼠标未连接时隐藏任务栏控件"
                                  Checked="OnDisplayChanged" Unchecked="OnDisplayChanged" />

                        <Grid Margin="0,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显示位置" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="PositionCombo" Width="180"
                                      SelectionChanged="PositionCombo_SelectionChanged">
                                <ComboBoxItem Content="紧贴通知区域" Tag="0" />
                                <ComboBoxItem Content="任务栏居中" Tag="1" />
                                <ComboBoxItem Content="靠近开始按钮" Tag="2" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="与锚点的距离" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="OffsetText" Text="6 px" Foreground="#FF6B7280" />
                        </Grid>
                        <Slider x:Name="OffsetSlider" Minimum="0" Maximum="600" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_ValueChanged" />
                        <TextBlock Text="任务栏上已经有别的挂件（例如 FluentFlyout 的媒体控件）时，调大这个值可以把本控件往左错开。"
                                   FontSize="11.5" Foreground="#FF6B7280" Margin="0,4,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="电量刷新间隔" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="PollCombo" Width="120"
                                      SelectionChanged="PollCombo_SelectionChanged">
                                <ComboBoxItem Content="30 秒" Tag="30" />
                                <ComboBoxItem Content="60 秒" Tag="60" />
                                <ComboBoxItem Content="120 秒" Tag="120" />
                                <ComboBoxItem Content="300 秒" Tag="300" />
                                <ComboBoxItem Content="600 秒" Tag="600" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="调试日志" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11.5"
                         Background="White" BorderBrush="#FFE5E7EB" Padding="8" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RefreshButton" Content="立即刷新" Click="Refresh_Click" />
            <Button x:Name="CloseButton" Content="关闭" Click="Close_Click" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
