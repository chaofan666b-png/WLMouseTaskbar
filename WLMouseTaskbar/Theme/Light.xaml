<!-- 浅色主题的颜色令牌。对应 WinUI 3 的 Light 主题。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口底色 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="LayerBackground" Color="#FFFFFF" />

    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardStroke" Color="#0F000000" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#F9F9F9" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
    <SolidColorBrush x:Key="TextDisabled" Color="#5C000000" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="ControlBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlStroke" Color="#19000000" />

    <!-- 强调色（WinUI 默认蓝） -->
    <SolidColorBrush x:Key="AccentFill" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#140067C0" />

    <!-- 导航 -->
    <SolidColorBrush x:Key="NavBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="NavItemHover" Color="#0A000000" />
    <SolidColorBrush x:Key="NavItemSelected" Color="#0F000000" />
    <SolidColorBrush x:Key="NavSelectionBar" Color="#0067C0" />

    <!-- 滑杆 / 开关 -->
    <SolidColorBrush x:Key="SliderTrack" Color="#3C000000" />
    <SolidColorBrush x:Key="ToggleOffTrack" Color="#0F000000" />
    <SolidColorBrush x:Key="ToggleOffStroke" Color="#8A000000" />
    <SolidColorBrush x:Key="ToggleOffKnob" Color="#8A000000" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#4D000000" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="SuccessText" Color="#0F7B0F" />
    <SolidColorBrush x:Key="WarningText" Color="#9D5D00" />
    <SolidColorBrush x:Key="CriticalText" Color="#C42B1C" />
</ResourceDictionary>
