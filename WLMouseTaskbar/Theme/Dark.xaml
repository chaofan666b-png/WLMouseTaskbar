<!-- 深色主题的颜色令牌。对应 WinUI 3 的 Dark 主题。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="LayerBackground" Color="#2C2C2C" />

    <SolidColorBrush x:Key="CardBackground" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardStroke" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#2C2C2C" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="TextDisabled" Color="#5DFFFFFF" />

    <SolidColorBrush x:Key="ControlBackground" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundHover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlStroke" Color="#18FFFFFF" />

    <SolidColorBrush x:Key="AccentFill" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentText" Color="#000000" />
    <SolidColorBrush x:Key="AccentSubtle" Color="#1F4CC2FF" />

    <SolidColorBrush x:Key="NavBackground" Color="#202020" />
    <SolidColorBrush x:Key="NavItemHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="NavItemSelected" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="NavSelectionBar" Color="#4CC2FF" />

    <SolidColorBrush x:Key="SliderTrack" Color="#54FFFFFF" />
    <SolidColorBrush x:Key="ToggleOffTrack" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ToggleOffStroke" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="ToggleOffKnob" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#54FFFFFF" />

    <SolidColorBrush x:Key="SuccessText" Color="#6CCB5F" />
    <SolidColorBrush x:Key="WarningText" Color="#FCE100" />
    <SolidColorBrush x:Key="CriticalText" Color="#FF99A4" />
</ResourceDictionary>
